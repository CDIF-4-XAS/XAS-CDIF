  "@type": [
    "skos:Concept"
  ],
  "skos:prefLabel": {
    "@value": "Sample analysis event",
    "@language": "en"
  },
  "dcterms:references": [
    "https://docs.xrayabsorption.org/NXxas/Q2XAFS2024_data.pdf",
    "https://doi.org/10.5281/zenodo.14920226"
  ],
  "skos:definition": {
    "@value": "An event in which one or more properties of a prepared material sample are measured.",
    "@language": "en"
  },
  "skos:inScheme": {
    "@id": "https://w3id.org/cdif/xas/CDIF4XAS_Reference_Concepts"
  },
  "skos:note": {
    "@value": "Note, label as 'sample analysis event' to distinguish from 'Analysis' as scientific activity to interpret data.  'A detailed examination or study of something so as to determine its nature, structure, or essential features.' (Oxford English Dictionary)",
    "@language": "en"
  }
}
