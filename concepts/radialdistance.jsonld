  "@id": "https://w3id.org/cdif/xas/radialdistance",
  "@type": [
    "skos:Concept"
  ],
  "skos:prefLabel": {
    "@value": "Radial distance",
    "@language": "en"
  },
  "dcterms:references": [
    "https://github.com/XraySpectroscopy/XAS-Data-Interchange/blob/master/specification/dictionary.md",
    "https://en.wikipedia.org/wiki/Extended_X-ray_absorption_fine_structure",
    "https://doi.org/10.5281/zenodo.14920226"
  ],
  "skos:definition": {
    "@value": "The R-space (radial distance space) coordinate of the Extended X-ray Absorption Fine Structure (EXAFS) oscillations, obtained by performing the Fourier transform of chi(k) in k-space. Peaks in |chi(R)| correspond to backscattering shells around the absorbing atom.",
    "@language": "en"
  },
  "skos:inScheme": {
    "@id": "https://w3id.org/cdif/xas/CDIF4XAS_Reference_Concepts"
  },
  "skos:notation": [
    "r"
  ],
  "skos:note": {
    "@value": "XDI Column.r: radial distance from absorbing atom (typically Angstroms).",
    "@language": "en"
  }
}
