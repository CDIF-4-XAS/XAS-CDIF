  "qudt:hasUnit": "unit:UNITLESS",
  "skos:definition": {
    "@value": "Opacity of the sample material relative to the incident X-ray beam.",
    "@language": "en"
  },
  "skos:inScheme": {
    "@id": "https://w3id.org/cdif/xas/CDIF4XAS_Reference_Concepts"
  },
  "skos:note": {
    "@value": "Dimensionless: a ratio relative to the incident beam. Stated here because the file formats do not record a unit for this quantity, so a consumer cannot otherwise tell 'dimensionless' from 'unit not recorded'.",
    "@language": "en"
  }
