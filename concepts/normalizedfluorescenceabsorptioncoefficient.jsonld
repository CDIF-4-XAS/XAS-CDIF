  "skos:note": [
    {
      "@value": "XDI Column.normfluor: normalized mu fluorescence.",
      "@language": "en"
    },
    {
      "@value": "Dimensionless: rescaled to unit edge step. Stated here because the file formats do not record a unit for this quantity, so a consumer cannot otherwise tell 'dimensionless' from 'unit not recorded'.",
