  "@id": "https://w3id.org/cdif/xas/flux",
  "@type": [
    "skos:Concept"
  ],
  "skos:prefLabel": {
    "@value": "Beamline flux",
    "@language": "en"
  },
  "foaf:focus": {
    "@id": "http://purl.org/nexusformat/definitions/Field/NXsource/flux"
  },
  "dcterms:references": "https://doi.org/10.5281/zenodo.14920226",
  "rdfs:seeAlso": "https://manual.nexusformat.org/classes/base_classes/NXsource.html#nxsource-flux-field",
  "skos:definition": {
    "@value": "The total number of photons or particles passing through a given area per second: Source intensity/area (example: s-1 cm-2).  Distinct from photon flux -- the total number of photons (intensity) traveling down the beamline per second (photons per s). Photon flux might be labeled Beamline flux.",
    "@language": "en"
  },
  "skos:inScheme": {
    "@id": "https://w3id.org/cdif/xas/CDIF4XAS_Reference_Concepts"
  }
}
