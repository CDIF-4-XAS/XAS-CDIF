  "@id": "https://w3id.org/cdif/xas/sampledescription",
  "@type": [
    "skos:Concept"
  ],
  "skos:prefLabel": {
    "@value": "Sample description",
    "@language": "en"
  },
  "rdfs:seeAlso": "https://manual.nexusformat.org/classes/base_classes/NXsample.html",
  "skos:definition": {
    "@value": "Free-text description of the sample. Broader than sample preparation: it may record the sample's form, dimensions, provenance or identity as well as how it was prepared.",
    "@language": "en"
  },
  "skos:inScheme": {
    "@id": "https://w3id.org/cdif/xas/CDIF4XAS_Reference_Concepts"
  },
  "skos:note": {
    "@value": "Grounded in the NeXus NXDL documentation for NXsample/description, 'Description of the sample'. Minted 2026-07-28 because the glossary had no general free-text sample concept, which forced samplepreparation into a closeMatch against that field. XDI has no counterpart tag; its Sample.prep text maps to samplepreparation.",
    "@language": "en"
  }
}
