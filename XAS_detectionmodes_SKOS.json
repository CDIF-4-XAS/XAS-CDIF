  "@graph": [
    {
      "@id": "https://w3id.org/cdif/xas/XAS_DetectionModes",
      "@type": "skos:ConceptScheme",
      "prefLabel": {
        "@value": "XAS detection modes",
        "@language": "en"
      },
      "definition": {
        "@value": "Detection methods used to observe sample absorption in an XAS measurement. Value list for the CDIF XAS concept 'xasmeasurementmode'. This list is the union of the upstream NeXus NXxas mode enumeration and the per-mode application definitions in the XAS community fork: the fork adds HERFD and splits total from partial fluorescence yield, but drops Auger electron yield.",
        "@language": "en"
      },
      "note": {
        "@value": "Generated from NeXus application definitions at XraySpectroscopy/nexus_definitions@main and the upstream NXxas mode enumeration.",
        "@language": "en"
      },
      "hasTopConcept": [
        {
          "@id": "https://w3id.org/cdif/xas/detectionmode/transmission"
        },
        {
          "@id": "https://w3id.org/cdif/xas/detectionmode/totalelectronyield"
        },
        {
          "@id": "https://w3id.org/cdif/xas/detectionmode/partialelectronyield"
        },
        {
          "@id": "https://w3id.org/cdif/xas/detectionmode/augerelectronyield"
        },
        {
          "@id": "https://w3id.org/cdif/xas/detectionmode/totalfluorescenceyield"
        },
        {
          "@id": "https://w3id.org/cdif/xas/detectionmode/partialfluorescenceyield"
        },
        {
          "@id": "https://w3id.org/cdif/xas/detectionmode/herfd"
        }
      ]
    },
    {
      "@id": "https://w3id.org/cdif/xas/detectionmode/transmission",
      "@type": "skos:Concept",
      "prefLabel": {
        "@value": "Transmission",
        "@language": "en"
      },
      "altLabel": [
        {
          "@value": "trans",
          "@language": "en"
        }
      ],
      "definition": {
        "@value": "The absorption coefficient is obtained from the Beer-Lambert law, mu(E)t = -ln(I/I0), where I is the transmitted and I0 the incident beam intensity.",
        "@language": "en"
      },
      "notation": "transmission",
      "inScheme": {
        "@id": "https://w3id.org/cdif/xas/XAS_DetectionModes"
      },
      "broader": {
        "@id": "https://w3id.org/cdif/xas/xasmeasurementmode"
      },
      "seeAlso": "https://manual.nexusformat.org/classes/contributed_definitions/NXxas_trans.html",
      "note": {
        "@value": "Corresponds to NeXus application definition NXxas_trans.",
        "@language": "en"
      }
    },
    {
      "@id": "https://w3id.org/cdif/xas/detectionmode/totalelectronyield",
      "@type": "skos:Concept",
      "prefLabel": {
        "@value": "Total electron yield",
        "@language": "en"
      },
      "altLabel": [
        {
          "@value": "TEY",
          "@language": "en"
        }
      ],
      "definition": {
        "@value": "The spectrum is measured by collecting all secondary electrons emitted from the sample surface; the drain current is proportional to the absorption coefficient.",
        "@language": "en"
      },
      "notation": "totalelectronyield",
      "inScheme": {
        "@id": "https://w3id.org/cdif/xas/XAS_DetectionModes"
      },
      "broader": {
        "@id": "https://w3id.org/cdif/xas/xasmeasurementmode"
      },
      "seeAlso": "https://manual.nexusformat.org/classes/contributed_definitions/NXxas_tey.html",
      "note": {
        "@value": "Corresponds to NeXus application definition NXxas_tey.",
        "@language": "en"
      }
    },
    {
      "@id": "https://w3id.org/cdif/xas/detectionmode/partialelectronyield",
      "@type": "skos:Concept",
      "prefLabel": {
        "@value": "Partial electron yield",
        "@language": "en"
      },
      "altLabel": [
        {
          "@value": "PEY",
          "@language": "en"
        }
      ],
      "definition": {
        "@value": "The spectrum is measured by collecting electrons above a kinetic energy threshold, using a retarding voltage to discriminate against low-energy secondary electrons.",
        "@language": "en"
      },
      "notation": "partialelectronyield",
      "inScheme": {
        "@id": "https://w3id.org/cdif/xas/XAS_DetectionModes"
      },
      "broader": {
        "@id": "https://w3id.org/cdif/xas/xasmeasurementmode"
      },
      "seeAlso": "https://manual.nexusformat.org/classes/contributed_definitions/NXxas_pey.html",
      "note": {
        "@value": "Corresponds to NeXus application definition NXxas_pey.",
        "@language": "en"
      }
    },
    {
      "@id": "https://w3id.org/cdif/xas/detectionmode/augerelectronyield",
      "@type": "skos:Concept",
      "prefLabel": {
        "@value": "Auger electron yield",
        "@language": "en"
      },
      "altLabel": [
        {
          "@value": "AEY",
          "@language": "en"
        }
      ],
      "definition": {
        "@value": "The spectrum is measured by collecting Auger electrons of a selected kinetic energy.",
        "@language": "en"
      },
      "notation": "augerelectronyield",
      "inScheme": {
        "@id": "https://w3id.org/cdif/xas/XAS_DetectionModes"
      },
      "broader": {
        "@id": "https://w3id.org/cdif/xas/xasmeasurementmode"
      },
      "note": {
        "@value": "Present in the upstream NeXus NXxas mode enumeration but with no application definition in the XAS fork.",
        "@language": "en"
      }
    },
    {
      "@id": "https://w3id.org/cdif/xas/detectionmode/totalfluorescenceyield",
      "@type": "skos:Concept",
      "prefLabel": {
        "@value": "Total fluorescence yield",
        "@language": "en"
      },
      "altLabel": [
        {
          "@value": "TFY",
          "@language": "en"
        }
      ],
      "definition": {
        "@value": "The absorption coefficient is proportional to the ratio of total fluorescence intensity to incident beam intensity.",
        "@language": "en"
      },
      "notation": "totalfluorescenceyield",
      "inScheme": {
        "@id": "https://w3id.org/cdif/xas/XAS_DetectionModes"
      },
      "broader": {
        "@id": "https://w3id.org/cdif/xas/xasmeasurementmode"
      },
      "seeAlso": "https://manual.nexusformat.org/classes/contributed_definitions/NXxas_tfy.html",
      "note": {
        "@value": "Corresponds to NeXus application definition NXxas_tfy.",
        "@language": "en"
      }
    },
    {
      "@id": "https://w3id.org/cdif/xas/detectionmode/partialfluorescenceyield",
      "@type": "skos:Concept",
      "prefLabel": {
        "@value": "Partial fluorescence yield",
        "@language": "en"
      },
      "altLabel": [
        {
          "@value": "PFY",
          "@language": "en"
        }
      ],
      "definition": {
        "@value": "The absorption coefficient is obtained from fluorescence intensity measured over a selected emission-energy window or detector channels.",
        "@language": "en"
      },
      "notation": "partialfluorescenceyield",
      "inScheme": {
        "@id": "https://w3id.org/cdif/xas/XAS_DetectionModes"
      },
      "broader": {
        "@id": "https://w3id.org/cdif/xas/xasmeasurementmode"
      },
      "seeAlso": "https://manual.nexusformat.org/classes/contributed_definitions/NXxas_pfy.html",
      "note": {
        "@value": "Corresponds to NeXus application definition NXxas_pfy.",
        "@language": "en"
      }
    },
    {
      "@id": "https://w3id.org/cdif/xas/detectionmode/herfd",
      "@type": "skos:Concept",
      "prefLabel": {
        "@value": "High energy resolution fluorescence detected",
        "@language": "en"
      },
      "altLabel": [
        {
          "@value": "HERFD",
          "@language": "en"
        }
      ],
      "definition": {
        "@value": "The spectrum is measured with crystal analyzers selecting a narrow emission energy, giving sharper spectral features than conventional fluorescence detection.",
        "@language": "en"
      },
      "notation": "herfd",
      "inScheme": {
        "@id": "https://w3id.org/cdif/xas/XAS_DetectionModes"
      },
      "broader": {
        "@id": "https://w3id.org/cdif/xas/xasmeasurementmode"
      },
      "seeAlso": "https://manual.nexusformat.org/classes/contributed_definitions/NXxas_herfd.html",
      "note": {
        "@value": "Corresponds to NeXus application definition NXxas_herfd.",
        "@language": "en"
      }
    }
  ]
}