{
    "_comment": "JSON-LD frame for the CDIF xasDocument/1.0 composite profile (https://w3id.org/cdif/xasDocument/1.0). Structures a JSON-LD input to match the shape the resolved JSON Schema expects: schema:Dataset root, embedded distribution / structure / variableMeasured / provenance / contributor blocks, and XAS-specific slots on the wasGeneratedBy activity (peer schema:instrument under prov:used, schema:object MaterialSample, schema:measurementTechnique / schema:keywords DefinedTerms). Based on the CDIF Data Description Structure profile frame, extended with the XAS-specific sub-frames enumerated below.",

    "@context": {
        "schema": "http://schema.org/",
        "dcterms": "http://purl.org/dc/terms/",
        "dcat": "http://www.w3.org/ns/dcat#",
        "prov": "http://www.w3.org/ns/prov#",
        "dqv": "http://www.w3.org/ns/dqv#",
        "geosparql": "http://www.opengis.net/ont/geosparql#",
        "spdx": "http://spdx.org/rdf/terms#",
        "time": "http://www.w3.org/2006/time#",
        "sf": "http://www.opengis.net/ont/sf#",
        "cdi": "http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/",
        "cdif": "https://w3id.org/cdif/",
        "csvw": "http://www.w3.org/ns/csvw#",
        "skos": "http://www.w3.org/2004/02/skos/core#",
        "xas": "https://w3id.org/cdif/xas/",
        "nxs": "https://manual.nexusformat.org/classes/",
        "ex": "https://example.org/",
        "xsd": "http://www.w3.org/2001/XMLSchema#"
    },

    "@type": "schema:Dataset",
    "@embed": "@always",

    "schema:name": {},
    "schema:description": {},
    "schema:identifier": {"@embed": "@always"},
    "schema:dateModified": {},
    "schema:datePublished": {},
    "schema:version": {},
    "schema:inLanguage": {},
    "schema:url": {},

    "schema:additionalType": {"@embed": "@always"},
    "schema:sameAs": {"@embed": "@always"},
    "schema:license": {"@embed": "@always"},
    "schema:conditionsOfAccess": {"@embed": "@always"},

    "schema:creator": {
        "@embed": "@always",
        "schema:name": {},
        "schema:identifier": {"@embed": "@always"},
        "schema:affiliation": {
            "@embed": "@always",
            "schema:name": {},
            "schema:identifier": {"@embed": "@always"}
        },
        "schema:contactPoint": {"@embed": "@always"}
    },

    "schema:contributor": {
        "@embed": "@always",
        "schema:name": {},
        "schema:description": {},
        "schema:alternateName": {},
        "schema:additionalType": {"@embed": "@always"},
        "schema:sameAs": {"@embed": "@always"},
        "schema:affiliation": {
            "@embed": "@always",
            "schema:name": {},
            "schema:identifier": {"@embed": "@always"}
        },
        "schema:identifier": {"@embed": "@always"},
        "schema:contactPoint": {"@embed": "@always"},
        "schema:roleName": {"@embed": "@always"},
        "schema:contributor": {
            "@embed": "@always",
            "schema:name": {},
            "schema:identifier": {"@embed": "@always"}
        }
    },

    "schema:publisher": {
        "@embed": "@always",
        "schema:name": {},
        "schema:identifier": {"@embed": "@always"}
    },

    "schema:provider": {
        "@embed": "@always",
        "schema:name": {},
        "schema:identifier": {"@embed": "@always"}
    },

    "schema:funding": {
        "@embed": "@always",
        "schema:name": {},
        "schema:description": {},
        "schema:funder": {
            "@embed": "@always",
            "schema:name": {},
            "schema:identifier": {"@embed": "@always"}
        },
        "schema:identifier": {"@embed": "@always"}
    },

    "_comment_keywords": "xasCore: element-symbol and element-edge DefinedTerms. schema:keywords must be a DefinedTerm (not a plain string).",
    "schema:keywords": {
        "@embed": "@always",
        "schema:name": {},
        "schema:identifier": {"@embed": "@always"},
        "schema:termCode": {},
        "schema:inDefinedTermSet": {"@embed": "@always"},
        "schema:about": {}
    },

    "_comment_measurementTechnique": "xasCore: PaNET XAS DefinedTerm + NeXus acquisition-mode DefinedTerm.",
    "schema:measurementTechnique": {
        "@embed": "@always",
        "schema:name": {},
        "schema:identifier": {"@embed": "@always"},
        "schema:termCode": {},
        "schema:inDefinedTermSet": {"@embed": "@always"},
        "schema:about": {}
    },

    "schema:distribution": {
        "@embed": "@always",
        "schema:name": {},
        "schema:contentUrl": {},
        "schema:description": {},
        "schema:encodingFormat": {},
        "spdx:checksum": {"@embed": "@always"},
        "schema:provider": {
            "@embed": "@always",
            "schema:name": {},
            "schema:identifier": {"@embed": "@always"}
        },
        "dcterms:conformsTo": {"@embed": "@always"},
        "cdi:characterSet": {},
        "cdif:fileSize": {},
        "cdif:fileSizeUofM": {},
        "cdi:arrayBase": {},
        "csvw:commentPrefix": {},
        "csvw:delimiter": {},
        "cdi:escapeCharacter": {},
        "csvw:header": {},
        "cdi:headerIsCaseSensitive": {},
        "csvw:headerRowCount": {},
        "cdi:isDelimited": {},
        "cdi:isFixedWidth": {},
        "csvw:lineTerminators": {},
        "csvw:quoteChar": {},
        "cdi:commentPrefix": {},
        "cdif:hasPhysicalMapping": {
            "@embed": "@always",
            "cdif:index": {},
            "cdif:locator": {},
            "cdif:format": {},
            "cdif:physicalDataType": {},
            "cdi:length": {},
            "cdi:nullSequence": {},
            "cdi:defaultValue": {},
            "cdi:minimumLength": {},
            "cdi:maximumLength": {},
            "cdif:formats_InstanceVariable": {"@embed": "@never"}
        },
        "cdi:isStructuredBy": {
            "@embed": "@always",
            "schema:name": {},
            "schema:identifier": {"@embed": "@always"},
            "cdi:has_DataStructureComponent": {
                "@embed": "@always",
                "cdif:isDefinedBy_RepresentedVariable": {
                    "@embed": "@always",
                    "cdif:name": {},
                    "schema:name": {}
                }
            }
        }
    },

    "schema:variableMeasured": {
        "@embed": "@always",
        "schema:name": {},
        "schema:description": {},
        "schema:alternateName": {},
        "schema:propertyID": {"@embed": "@always"},
        "schema:measurementTechnique": {"@embed": "@always"},
        "schema:unitText": {},
        "schema:unitCode": {"@embed": "@always"},
        "schema:minValue": {},
        "schema:maxValue": {},
        "schema:url": {},
        "cdif:physicalDataType": {},
        "cdif:simpleUnitOfMeasure": {"@embed": "@always"},
        "cdif:uses": {"@embed": "@always"}
    },

    "schema:spatialCoverage": {
        "@embed": "@always",
        "schema:name": {"@embed": "@always"},
        "schema:identifier": {"@embed": "@always"},
        "schema:alternateName": {"@embed": "@always"},
        "schema:additionalType": {"@embed": "@always"},
        "schema:geo": {"@embed": "@always"},
        "geosparql:hasGeometry": {
            "@embed": "@always",
            "geosparql:asWKT": {"@embed": "@always"},
