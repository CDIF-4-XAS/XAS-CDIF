        "schema:target": {"@embed": "@always"}
    },

    "_comment_wasGeneratedBy": "xasCore analysis Activity (Action). Requires xas:analysisevent in schema:additionalType, peer schema:instrument entries in prov:used covering beamline/mono/detector/source, schema:object as MaterialSample, and schema:location as Place with xas:facility additionalType.",
    "prov:wasGeneratedBy": {
        "@embed": "@always",
        "schema:additionalType": {"@embed": "@always"},
        "schema:name": {},
        "schema:description": {},
        "schema:startDate": {},
        "schema:startTime": {},
        "schema:endTime": {},
        "schema:actionStatus": {},
        "schema:error": {},

        "prov:used": {
            "@embed": "@always",
            "schema:instrument": {
                "@embed": "@always",
                "schema:name": {},
                "schema:identifier": {"@embed": "@always"},
                "schema:additionalType": {"@embed": "@always"},
                "schema:additionalProperty": {
                    "@embed": "@always",
                    "schema:name": {},
                    "schema:propertyID": {"@embed": "@always"},
                    "schema:value": {},
                    "schema:unitText": {},
                    "schema:unitCode": {"@embed": "@always"}
                },
                "schema:model": {
                    "@embed": "@always",
                    "schema:name": {},
                    "schema:identifier": {"@embed": "@always"}
                },
                "schema:hasPart": {
                    "@embed": "@always",
                    "schema:name": {},
                    "schema:additionalType": {"@embed": "@always"},
                    "schema:additionalProperty": {
                        "@embed": "@always",
                        "schema:name": {},
                        "schema:propertyID": {"@embed": "@always"},
                        "schema:value": {},
                        "schema:unitText": {}
                    },
                    "schema:model": {
                        "@embed": "@always",
                        "schema:name": {}
                    }
                }
            }
        },

        "_comment_object": "xasCore MaterialSample: schema:object is a Product/Thing dual-typed schema:additionalType [MaterialSample, iSamples materialsample IRI]. Carries the sample name and optional physico-chemical additionalProperty entries (xas:samplepreparation, xas:temperature, xas:porosity, xas:ph, ...).",
        "schema:object": {
            "@embed": "@always",
            "schema:name": {},
            "schema:description": {},
            "schema:identifier": {"@embed": "@always"},
            "schema:additionalType": {"@embed": "@always"},
            "schema:additionalProperty": {
                "@embed": "@always",
                "schema:name": {},
                "schema:propertyID": {"@embed": "@always"},
                "schema:value": {},
                "schema:unitText": {}
            }
        },

        "_comment_location": "xasCore beamline location: schema:location is a Place dual-typed schema:additionalType xas:facility. Optional schema:geo / geosparql:hasGeometry for beamline coordinates.",
        "schema:location": {
            "@embed": "@always",
            "schema:name": {},
            "schema:identifier": {"@embed": "@always"},
            "schema:additionalType": {"@embed": "@always"},
            "schema:geo": {
                "@embed": "@always",
                "schema:latitude": {},
                "schema:longitude": {}
            },
            "geosparql:hasGeometry": {
                "@embed": "@always",
                "geosparql:asWKT": {"@embed": "@always"},
                "geosparql:crs": {"@embed": "@always"}
            }
        },

