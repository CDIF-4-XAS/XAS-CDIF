    "_comment_subjectOf": "CatalogRecord for the dataset: dcterms:conformsTo declares the profile URIs (cdifCore/1.1, cdifDiscovery/1.1, cdifDataDescription/1.1, cdifDataStructure/1.1, xasCore/1.0, xasOptional/1.0).",
    "schema:subjectOf": {
        "@embed": "@always",
        "schema:about": {"@embed": "@always"},
        "schema:additionalType": {"@embed": "@always"},
        "schema:sdDatePublished": {},
