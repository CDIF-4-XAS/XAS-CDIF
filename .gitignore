# Python byte-code caches
__pycache__/
*.py[oc]

# Bundled zip archive of collection 203 — the exampleData/*.xdi
# files are the tracked, unpacked form.
exampleData/*.zip

# JetBrains IDE settings — local to one developer's machine
.idea/

# Pages build output: tools/generate_glossary_html.py and
# generate_concept_files.py write here, and CI regenerates it on every
# deploy. Anchored to the root so the tracked archive/ copy of the 1.0
# release is not matched.
/XAS-CDIF-1.0_release/
